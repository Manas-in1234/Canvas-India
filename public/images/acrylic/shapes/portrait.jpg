<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 200" width="150" height="200">
  <defs>
    <filter id="shadow-portrait" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.25"/>
    </filter>
    <linearGradient id="glare-portrait" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.7"/>
      <stop offset="40%" stop-color="#FFFFFF" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="chrome-portrait" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="40%" stop-color="#CBD5E1"/>
      <stop offset="80%" stop-color="#64748B"/>
      <stop offset="100%" stop-color="#334155"/>
    </radialGradient>
    <clipPath id="clip-portrait">
      <use href="#p-shape" />
    </clipPath>
    <rect id="p-shape" x="15" y="15" width="120" height="170" rx="12" />
    <linearGradient id="g-por" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4C1D95"/><stop offset="50%" stop-color="#7C3AED"/><stop offset="100%" stop-color="#C4B5FD"/></linearGradient>
  </defs>

  <!-- Drop Shadow -->
  <g filter="url(#shadow-portrait)">
    <use href="#p-shape" fill="#000000" opacity="0.2" />
  </g>

  <!-- Main Acrylic Plate with Image Art -->
  <g clip-path="url(#clip-portrait)">
    <!-- Gradient Landscape/Art Representation -->
    <rect width="150" height="200" fill="url(#g-por)" />
    
    <!-- Mountain/Horizon silhouettes representing photo art -->
    <path d="M 0 140 Q 37.5 90 75 130 T 150 110.00000000000001 L 150 200 L 0 200 Z" fill="#091E3A" opacity="0.35" />
    <circle cx="112.5" cy="70" r="18" fill="#FFF" opacity="0.3" />

    <!-- Glass Glare Reflection -->
    <rect width="150" height="200" fill="url(#glare-portrait)" />
  </g>

  <!-- Optical Beveled Edge -->
  <use href="#p-shape" fill="none" stroke="#FFFFFF" stroke-width="2.5" opacity="0.85" />

  <!-- Standoff Chrome Bolts -->
  
    <g>
      <circle cx="25" cy="25" r="4" fill="url(#chrome-portrait)" stroke="#1E293B" stroke-width="0.75" />
      <circle cx="25" cy="25" r="1.2" fill="#0F172A" />
    </g>
  
    <g>
      <circle cx="125" cy="25" r="4" fill="url(#chrome-portrait)" stroke="#1E293B" stroke-width="0.75" />
      <circle cx="125" cy="25" r="1.2" fill="#0F172A" />
    </g>
  
    <g>
      <circle cx="25" cy="175" r="4" fill="url(#chrome-portrait)" stroke="#1E293B" stroke-width="0.75" />
      <circle cx="25" cy="175" r="1.2" fill="#0F172A" />
    </g>
  
    <g>
      <circle cx="125" cy="175" r="4" fill="url(#chrome-portrait)" stroke="#1E293B" stroke-width="0.75" />
      <circle cx="125" cy="175" r="1.2" fill="#0F172A" />
    </g>
  
</svg>