    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { MandalaSegments } from \'../types\';\nimport { Sparkles, Eye, EyeOff } from \'lucide-react\';\n\ninterface MandalaControlProps {\n  segments: MandalaSegments;\n  onSegmentsChange: (segments: MandalaSegments) => void;\n  showGuides: boolean;\n  onToggleGuides: () => void;\n}\n\nexport const MandalaControl: React.FC<MandalaControlProps> = ({\n  segments,\n  onSegmentsChange,\n  showGuides,\n  onToggleGuides,\n}) => {\n  const options: MandalaSegments[] = [4, 6, 8, 12, 16];\n\n  return (\n    <div className=\"absolute top-4 left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-md px-4 py-2 rounded-2xl shadow-lg border border-amber-200 flex items-center gap-3 z-20 text-xs\">\n      <div className=\"flex items-center gap-1.5 text-amber-700 font-bold\">\n        <Sparkles className=\"w-4 h-4 text-amber-500 animate-pulse\" />\n        <span className=\"hidden sm:inline\">Mandala & Rangoli Symmetry</span>\n        <span className=\"sm:hidden\">Symmetry</span>\n      </div>\n\n      <div className=\"h-4 w-px bg-amber-200\" />\n\n      {/* Segment count buttons */}\n      <div className=\"flex items-center gap-1\">\n        <span className=\"text-[11px] text-stone-600 font-medium mr-1\">Petals/Rays:</span>\n        {options.map((seg) => (\n          <button\n            key={seg}\n            onClick={() => onSegmentsChange(seg)}\n            className={`px-2 py-0.5 rounded-md font-semibold text-xs transition-all ${\n              segments === seg\n                ? \'bg-amber-500 text-white shadow-xs scale-105\'\n                : \'bg-stone-100 text-stone-700 hover:bg-amber-100\'\n            }`}\n          >\n            {seg}x\n          </button>\n        ))}\n      </div>\n\n      <div className=\"h-4 w-px bg-amber-200\" />\n\n      {/* Guide lines toggle */}\n      <button\n        onClick={onToggleGuides}\n        className={`flex items-center gap-1 px-2 py-0.5 rounded-md font-medium text-xs transition-colors ${\n          showGuides\n            ? \'bg-amber-100 text-amber-900 border border-amber-300\'\n            : \'text-stone-500 hover:text-stone-800\'\n        }`}\n        title=\"Toggle radial guideline grid\"\n      >\n        {showGuides ? <Eye className=\"w-3.5 h-3.5\" /> : <EyeOff className=\"w-3.5 h-3.5\" />}\n        <span className=\"hidden sm:inline\">{showGuides ? \'Guides Visible\' : \'Guides Hidden\'}</span>\n      </button>\n    </div>\n  );\n};\n"
    }
