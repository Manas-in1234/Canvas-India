      replacement_content: "import React, { useState } from \'react\';\nimport { INDIAN_PALETTES } from \'../data/palettes\';\nimport { Sliders, Check } from \'lucide-react\';\n\ninterface ColorPaletteProps {\n  currentColor: string;\n  onColorChange: (color: string) => void;\n  strokeWidth: number;\n  onStrokeWidthChange: (width: number) => void;\n  opacity: number;\n  onOpacityChange: (opacity: number) => void;\n  isFilled: boolean;\n  onToggleFilled: (filled: boolean) => void;\n  showShapeControls?: boolean;\n}\n\nexport const ColorPalettePanel: React.FC<ColorPaletteProps> = ({\n  currentColor,\n  onColorChange,\n  strokeWidth,\n  onStrokeWidthChange,\n  opacity,\n  onOpacityChange,\n  isFilled,\n  onToggleFilled,\n  showShapeControls = false,\n}) => {\n  const [selectedPaletteId, setSelectedPaletteId] = useState<string>(\'tiranga\');\n  const activePalette = INDIAN_PALETTES.find((p) => p.id === selectedPaletteId) || INDIAN_PALETTES[0];\n\n  return (\n    <div className=\"bg-white border-t border-stone-200 px-4 py-2.5 shadow-xs z-10 select-none\">\n      <div className=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n        \n        {/* Left: Indian Cultural Color Swatches */}\n        <div className=\"flex items-center gap-3 flex-wrap\">\n          {/* Palette selector dropdown */}\n          <div className=\"flex flex-col\">\n            <label className=\"text-[10px] font-bold uppercase tracking-wider text-stone-600 mb-0.5\">\n              Indian Palette\n            </label>\n            <select\n              value={selectedPaletteId}\n              onChange={(e) => setSelectedPaletteId(e.target.value)}\n              className=\"text-xs font-semibold bg-stone-100 border border-stone-200 rounded-lg px-2 py-1 text-stone-800 focus:outline-hidden focus:ring-1 focus:ring-orange-500 cursor-pointer\"\n            >\n              {INDIAN_PALETTES.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Color swatches */}\n          <div className=\"flex items-center gap-1.5 flex-wrap\">\n            {activePalette.colors.map((c) => {\n              const isSelected = currentColor.toLowerCase() === c.toLowerCase();\n              return (\n                <button\n                  key={c}\n                  onClick={() => onColorChange(c)}\n                  title={c}\n                  style={{ backgroundColor: c }}\n                  className={`w-7 h-7 rounded-full transition-transform flex items-center justify-center border ${\n                    c.toLowerCase() === \'#ffffff\' ? \'border-stone-300\' : \'border-black/10\'\n                  } ${\n                    isSelected\n                      ? \'scale-110 ring-2 ring-orange-500 ring-offset-2 shadow-xs\'\n                      : \'hover:scale-105\'\n                  }`}\n                >\n                  {isSelected && (\n                    <Check \n                      className={`w-3.5 h-3.5 ${\n                        [\'#ffffff\', \'#fef08a\', \'#fef3c7\', \'#fbbf24\'].includes(c.toLowerCase())\n                          ? \'text-stone-900\'\n                          : \'text-white\'\n                      }`} \n                    />\n                  )}\n                </button>\n              );\n            })}\n\n            {/* Custom Color Input Picker */}\n            <div className=\"relative ml-1\">\n              <label \n                htmlFor=\"custom-color-picker\"\n                title=\"Pick custom hex color\"\n                className=\"w-7 h-7 rounded-full border border-stone-300 flex items-center justify-center cursor-pointer bg-conic-gradient hover:scale-105 transition-transform\"\n                style={{\n                  background: \'conic-gradient(red, yellow, lime, aqua, blue, magenta, red)\',\n                }}\n              >\n                <input\n                  id=\"custom-color-picker\"\n                  type=\"color\"\n                  value={currentColor}\n                  onChange={(e) => onColorChange(e.target.value)}\n                  className=\"opacity-0 w-full h-full cursor-pointer absolute inset-0\"\n                />\n              </label>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: Brush Size, Opacity & Shape Fill Controls */}\n        <div className=\"flex items-center gap-4 flex-wrap\">\n          {/* Stroke Width Slider & Preview Dot */}\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] font-bold uppercase tracking-wider text-stone-600\">\n                Stroke: {strokeWidth}px\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"range\"\n                  min=\"1\"\n                  max=\"60\"\n                  value={strokeWidth}\n                  onChange={(e) => onStrokeWidthChange(Number(e.target.value))}\n                  className=\"w-24 sm:w-28 accent-orange-600 h-1.5 bg-stone-200 rounded-lg cursor-pointer\"\n                />\n                <div \n                  className=\"rounded-full border border-stone-300 shrink-0 transition-all\"\n                  style={{\n                    width: `${Math.min(24, Math.max(6, strokeWidth / 2))}px`,\n                    height: `${Math.min(24, Math.max(6, strokeWidth / 2))}px`,\n                    backgroundColor: currentColor,\n                    opacity: opacity,\n                  }}\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Opacity Slider */}\n          <div className=\"flex flex-col\">\n            <span className=\"text-[10px] font-bold uppercase tracking-wider text-stone-600\">\n              Opacity: {Math.round(opacity * 100)}%\n            </span>\n            <input\n              type=\"range\"\n              min=\"0.05\"\n              max=\"1\"\n              step=\"0.05\"\n              value={opacity}\n              onChange={(e) => onOpacityChange(Number(e.target.value))}\n              className=\"w-20 sm:w-24 accent-orange-600 h-1.5 bg-stone-200 rounded-lg cursor-pointer\"\n            />\n          </div>\n\n          {/* Fill shape checkbox */}\n          {showShapeControls && (\n            <div className=\"flex items-center gap-1.5 pl-2 border-l border-stone-200\">\n              <label className=\"flex items-center gap-1.5 text-xs font-medium text-stone-700 cursor-pointer select-none\">\n                <input\n                  type=\"checkbox\"\n                  checked={isFilled}\n                  onChange={(e) => onToggleFilled(e.target.checked)}\n                  className=\"rounded-sm text-orange-600 focus:ring-orange-500 w-4 h-4\"\n                />\n                <span>Fill Shape</span>\n              </label>\n            </div>\n          )}\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
