      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Undo2, \n  Redo2, \n  RotateCcw, \n  Download, \n  Sparkles, \n  Volume2, \n  VolumeX, \n  ZoomIn, \n  ZoomOut, \n  Maximize2,\n  Palette,\n  MapPin\n} from \'lucide-react\';\nimport { isSoundEnabled, setSoundEnabled, playClearSound } from \'../utils/audio\';\n\ninterface HeaderProps {\n  title: string;\n  onTitleChange: (title: string) => void;\n  canUndo: boolean;\n  canRedo: boolean;\n  onUndo: () => void;\n  onRedo: () => void;\n  onClear: () => void;\n  onOpenTemplates: () => void;\n  onOpenExport: () => void;\n  zoom: number;\n  onZoomChange: (newZoom: number) => void;\n  activeTemplateName: string;\n  showMapOverlay: boolean;\n  onToggleMapOverlay: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  title,\n  onTitleChange,\n  canUndo,\n  canRedo,\n  onUndo,\n  onRedo,\n  onClear,\n  onOpenTemplates,\n  onOpenExport,\n  zoom,\n  onZoomChange,\n  activeTemplateName,\n  showMapOverlay,\n  onToggleMapOverlay,\n}) => {\n  const [soundOn, setSoundOn] = useState(isSoundEnabled());\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n\n  const toggleSound = () => {\n    const next = !soundOn;\n    setSoundOn(next);\n    setSoundEnabled(next);\n  };\n\n  const handleClearWithConfirm = () => {\n    if (window.confirm(\'Clear the entire canvas? Unsaved progress will be removed.\')) {\n      playClearSound();\n      onClear();\n    }\n  };\n\n  return (\n    <header className=\"h-16 bg-white border-b border-stone-200 px-4 flex items-center justify-between shadow-xs select-none z-20\">\n      {/* Brand & Title */}\n      <div className=\"flex items-center gap-3\">\n        <div className=\"flex items-center gap-2\">\n          {/* Logo badge with Tiranga gradient border */}\n          <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-stone-100 to-emerald-600 p-[2px] shadow-sm\">\n            <div className=\"w-full h-full bg-stone-900 rounded-[10px] flex items-center justify-center\">\n              {/* Ashoka Chakra & Lotus emblem */}\n              <svg className=\"w-6 h-6 text-amber-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"#38bdf8\" strokeWidth=\"1.5\" />\n                <path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4L18.4 5.6\" stroke=\"#38bdf8\" strokeWidth=\"1\" opacity=\"0.6\" />\n                <circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"#f59e0b\" stroke=\"#ffffff\" strokeWidth=\"1\" />\n              </svg>\n            </div>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-extrabold text-lg tracking-tight bg-gradient-to-r from-amber-600 via-orange-600 to-emerald-700 bg-clip-text text-transparent\">\n                Canvas India\n              </span>\n              <span className=\"hidden sm:inline-block text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200\">\n                Art Studio\n              </span>\n            </div>\n            \n            {/* Editable Project Title */}\n            {isEditingTitle ? (\n              <input\n                type=\"text\"\n                value={title}\n                onChange={(e) => onTitleChange(e.target.value)}\n                onBlur={() => setIsEditingTitle(false)}\n                onKeyDown={(e) => e.key === \'Enter\' && setIsEditingTitle(false)}\n                autoFocus\n                className=\"text-xs text-stone-700 border-b border-orange-500 focus:outline-hidden bg-transparent px-1 py-0.5 w-36\"\n              />\n            ) : (\n              <button \n                onClick={() => setIsEditingTitle(true)} \n                title=\"Click to rename artwork\"\n                className=\"text-xs text-stone-500 hover:text-stone-800 flex items-center gap-1 group text-left\"\n              >\n                <span className=\"truncate max-w-[140px] font-medium\">{title}</span>\n                <span className=\"text-[10px] text-stone-400 group-hover:text-orange-500\">\342\234\216</span>\n              </button>\n            )}\n          </div>\n        </div>\n\n        <div className=\"h-6 w-px bg-stone-200 mx-1 hidden md:block\" />\n\n        {/* Template Indicator */}\n        <button\n          onClick={onOpenTemplates}\n          className=\"hidden md:flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-stone-700 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors border border-stone-200\"\n          title=\"Change art canvas backdrop or theme\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 text-amber-600\" />\n          <span className=\"truncate max-w-[120px]\">{activeTemplateName}</span>\n        </button>\n\n        {/* Quick Map Mode Toggle */}\n        <button\n          onClick={onToggleMapOverlay}\n          className={`hidden lg:flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-lg transition-colors border ${\n            showMapOverlay\n              ? \'bg-sky-50 text-sky-700 border-sky-300 ring-1 ring-sky-400\'\n              : \'text-stone-600 bg-stone-50 hover:bg-stone-100 border-stone-200\'\n          }`}\n          title=\"Toggle India Geographic & Folk Art Regions Overlay\"\n        >\n          <MapPin className={`w-3.5 h-3.5 ${showMapOverlay ? \'text-sky-600\' : \'text-stone-400\'}`} />\n          <span>India Map {showMapOverlay ? \'On\' : \'Off\'}</span>\n        </button>\n      </div>\n\n      {/* History, Zoom & Actions */}\n      <div className=\"flex items-center gap-1 sm:gap-2\">\n        {/* Undo / Redo */}\n        <div className=\"flex items-center bg-stone-100 p-1 rounded-lg border border-stone-200\">\n          <button\n            onClick={onUndo}\n            disabled={!canUndo}\n            title=\"Undo stroke (Ctrl+Z)\"\n            className=\"p-1.5 rounded-md hover:bg-white text-stone-700 disabled:opacity-30 disabled:hover:bg-transparent transition-colors\"\n          >\n            <Undo2 className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={onRedo}\n            disabled={!canRedo}\n            title=\"Redo stroke (Ctrl+Y)\"\n            className=\"p-1.5 rounded-md hover:bg-white text-stone-700 disabled:opacity-30 disabled:hover:bg-transparent transition-colors\"\n          >\n            <Redo2 className=\"w-4 h-4\" />\n          </button>\n          <div className=\"h-4 w-px bg-stone-300 mx-1\" />\n          <button\n            onClick={handleClearWithConfirm}\n            title=\"Reset Canvas\"\n            className=\"p-1.5 rounded-md hover:bg-white text-rose-600 hover:text-rose-700 transition-colors\"\n          >\n            <RotateCcw className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Zoom controls */}\n        <div className=\"hidden sm:flex items-center bg-stone-100 p-1 rounded-lg border border-stone-200 text-xs\">\n          <button\n            onClick={() => onZoomChange(Math.max(0.5, zoom - 0.1))}\n            title=\"Zoom Out\"\n            className=\"p-1.5 rounded-md hover:bg-white text-stone-700 transition-colors\"\n          >\n            <ZoomOut className=\"w-3.5 h-3.5\" />\n          </button>\n          <span className=\"px-1.5 font-semibold text-stone-600 min-w-[42px] text-center\">\n            {Math.round(zoom * 100)}%\n          </span>\n          <button\n            onClick={() => onZoomChange(Math.min(2.5, zoom + 0.1))}\n            title=\"Zoom In\"\n            className=\"p-1.5 rounded-md hover:bg-white text-stone-700 transition-colors\"\n          >\n            <ZoomIn className=\"w-3.5 h-3.5\" />\n          </button>\n          <button\n            onClick={() => onZoomChange(1.0)}\n            title=\"Reset Zoom to 100%\"\n            className=\"p-1.5 rounded-md hover:bg-white text-stone-500 hover:text-stone-800 transition-colors\"\n          >\n            <Maximize2 className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Audio Mute/Unmute */}\n        <button\n          onClick={toggleSound}\n          title={soundOn ? \'Mute sound effects\' : \'Enable tactile brush sounds\'}\n          className={`p-2 rounded-lg border transition-colors ${\n            soundOn \n              ? \'bg-amber-50 text-amber-700 border-amber-200\' \n              : \'bg-stone-100 text-stone-400 border-stone-200 hover:text-stone-600\'\n          }`}\n        >\n          {soundOn ? <Volume2 className=\"w-4 h-4\" /> : <VolumeX className=\"w-4 h-4\" />}\n        </button>\n\n        {/* Mobile Templates Button */}\n        <button\n          onClick={onOpenTemplates}\n          className=\"md:hidden p-2 rounded-lg bg-stone-100 text-stone-700 border border-stone-200 hover:bg-stone-200\"\n          title=\"Backdrops & Templates\"\n        >\n          <Palette className=\"w-4 h-4 text-amber-600\" />\n        </button>\n\n        {/* Export / Download CTA */}\n        <button\n          onClick={onOpenExport}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-700 hover:to-amber-700 text-white text-xs font-semibold rounded-lg shadow-sm shadow-orange-600/20 transition-all hover:scale-[1.02] active:scale-[0.98]\"\n        >\n          <Download className=\"w-4 h-4\" />\n          <span className=\"hidden xs:inline\">Export Artwork</span>\n          <span className=\"xs:hidden\">Export</span>\n        </button>\n      </div>\n    </header>\n  );\n};\n"
    }
