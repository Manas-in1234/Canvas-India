    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Paintbrush, \n  PenTool, \n  Sparkles, \n  Highlighter, \n  SprayCan, \n  Eraser, \n  CircleDot, \n  Shapes, \n  Stamp, \n  Type,\n  MapPin\n} from \'lucide-react\';\nimport { ToolType } from \'../types\';\n\ninterface ToolbarProps {\n  activeTool: ToolType;\n  onSelectTool: (tool: ToolType) => void;\n  onOpenStamps: () => void;\n  onOpenShapes: () => void;\n  onOpenTextPrompt: () => void;\n}\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  activeTool,\n  onSelectTool,\n  onOpenStamps,\n  onOpenShapes,\n  onOpenTextPrompt,\n}) => {\n  const tools: { id: ToolType; name: string; icon: React.ReactNode; badge?: string; action?: () => void }[] = [\n    {\n      id: \'brush\',\n      name: \'Artistic Brush\',\n      icon: <Paintbrush className=\"w-5 h-5\" />,\n    },\n    {\n      id: \'pen\',\n      name: \'Fine Ink Pen\',\n      icon: <PenTool className=\"w-5 h-5\" />,\n    },\n    {\n      id: \'calligraphy\',\n      name: \'Calligraphy Kalam\',\n      icon: <Sparkles className=\"w-5 h-5\" />,\n      badge: \'Chisel\',\n    },\n    {\n      id: \'spray\',\n      name: \'Pichkari / Gulal Spray\',\n      icon: <SprayCan className=\"w-5 h-5\" />,\n      badge: \'Holi\',\n    },\n    {\n      id: \'highlighter\',\n      name: \'Highlighter\',\n      icon: <Highlighter className=\"w-5 h-5\" />,\n    },\n    {\n      id: \'mandala\',\n      name: \'Mandala / Rangoli Symmetry\',\n      icon: <CircleDot className=\"w-5 h-5 text-amber-500\" />,\n      badge: \'Live\',\n    },\n    {\n      id: \'shape\',\n      name: \'Indian & Geometric Shapes\',\n      icon: <Shapes className=\"w-5 h-5\" />,\n      action: onOpenShapes,\n    },\n    {\n      id: \'stamp\',\n      name: \'Folk Art Motifs & Stamps\',\n      icon: <Stamp className=\"w-5 h-5\" />,\n      badge: \'Warli\',\n      action: onOpenStamps,\n    },\n    {\n      id: \'text\',\n      name: \'Typography & Quotes\',\n      icon: <Type className=\"w-5 h-5\" />,\n      action: onOpenTextPrompt,\n    },\n    {\n      id: \'map\',\n      name: \'India Geographic Canvas\',\n      icon: <MapPin className=\"w-5 h-5 text-sky-600\" />,\n      badge: \'Map\',\n    },\n    {\n      id: \'eraser\',\n      name: \'Precision Eraser\',\n      icon: <Eraser className=\"w-5 h-5 text-rose-500\" />,\n    },\n  ];\n\n  return (\n    <aside className=\"w-16 md:w-20 bg-white border-r border-stone-200 flex flex-col items-center py-4 gap-2 z-10 shrink-0 shadow-xs\">\n      <div className=\"text-[10px] font-bold uppercase tracking-wider text-stone-600 text-center pb-1\">\n        Tools\n      </div>\n\n      <div className=\"flex flex-col gap-1.5 w-full px-2 overflow-y-auto max-h-[calc(100vh-140px)]\">\n        {tools.map((t) => {\n          const isActive = activeTool === t.id;\n          return (\n            <button\n              key={t.id}\n              onClick={() => {\n                onSelectTool(t.id);\n                if (t.action) t.action();\n              }}\n              title={t.name}\n              className={`relative group flex flex-col items-center justify-center p-2 rounded-xl transition-all ${\n                isActive\n                  ? \'bg-orange-50 text-orange-700 shadow-xs ring-2 ring-orange-500 font-semibold\'\n                  : \'text-stone-600 hover:bg-stone-100 hover:text-stone-900\'\n              }`}\n            >\n              <div className=\"relative\">\n                {t.icon}\n                {t.badge && (\n                  <span className={`absolute -top-1.5 -right-2 text-[8px] font-bold px-1 rounded-full uppercase tracking-tighter ${\n                    isActive ? \'bg-orange-600 text-white\' : \'bg-stone-200 text-stone-600 group-hover:bg-orange-200\'\n                  }`}>\n                    {t.badge}\n                  </span>\n                )}\n              </div>\n              <span className=\"text-[9px] mt-1 text-center truncate max-w-[56px] leading-tight opacity-90\">\n                {t.name.split(\' \')[0]}\n              </span>\n\n              {/* Hover tooltip for desktop */}\n              <div className=\"hidden group-hover:md:flex absolute left-full ml-2 px-2.5 py-1 bg-stone-900 text-white text-xs rounded-md shadow-lg whitespace-nowrap pointer-events-none z-50 items-center gap-1.5\">\n                <span>{t.name}</span>\n                {t.badge && (\n                  <span className=\"text-[9px] bg-orange-500 text-white px-1 rounded-xs uppercase\">\n                    {t.badge}\n                  </span>\n                )}\n              </div>\n            </button>\n          );\n        })}\n      </div>\n    </aside>\n  );\n};\n"
    }
