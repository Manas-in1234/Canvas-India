      replacement_content: "import React from \'react\';\nimport { ShapeType } from \'../types\';\nimport { \n  Square, \n  Circle, \n  Triangle, \n  Star, \n  Minus, \n  ArrowRight, \n  Flower2, \n  Sparkles, \n  X \n} from \'lucide-react\';\n\ninterface ShapeModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  selectedShape: ShapeType;\n  onSelectShape: (shape: ShapeType) => void;\n}\n\nexport const ShapeModal: React.FC<ShapeModalProps> = ({\n  isOpen,\n  onClose,\n  selectedShape,\n  onSelectShape,\n}) => {\n  if (!isOpen) return null;\n\n  const shapes: { id: ShapeType; name: string; icon: React.ReactNode; category: \'classic\' | \'indian\' }[] = [\n    { id: \'rectangle\', name: \'Rectangle\', icon: <Square className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'circle\', name: \'Circle\', icon: <Circle className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'triangle\', name: \'Triangle\', icon: <Triangle className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'star\', name: \'Star\', icon: <Star className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'line\', name: \'Straight Line\', icon: <Minus className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'arrow\', name: \'Arrow Pointer\', icon: <ArrowRight className=\"w-5 h-5\" />, category: \'classic\' },\n    { id: \'lotus\', name: \'Lotus (Padma)\', icon: <Flower2 className=\"w-5 h-5 text-rose-500\" />, category: \'indian\' },\n    { id: \'paisley\', name: \'Kalka (Paisley)\', icon: <Sparkles className=\"w-5 h-5 text-amber-600\" />, category: \'indian\' },\n    { id: \'chakra\', name: \'Chakra Circle\', icon: <Circle className=\"w-5 h-5 text-blue-600\" />, category: \'indian\' },\n  ];\n\n  return (\n    <div className=\"fixed inset-0 bg-stone-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-in fade-in duration-200\">\n      <div className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 border border-stone-200\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-stone-200\">\n          <div>\n            <h3 className=\"font-bold text-base text-stone-900\">Select Shape</h3>\n            <p className=\"text-xs text-stone-500\">Drag on canvas to place the shape</p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-stone-400 hover:text-stone-700 hover:bg-stone-100\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Categories */}\n        <div className=\"mt-4 space-y-4\">\n          <div>\n            <span className=\"text-[11px] font-bold uppercase tracking-wider text-orange-700 block mb-2\">\n              Indian Art Motifs\n            </span>\n            <div className=\"grid grid-cols-3 gap-2\">\n              {shapes.filter(s => s.category === \'indian\').map((s) => (\n                <button\n                  key={s.id}\n                  onClick={() => {\n                    onSelectShape(s.id);\n                    onClose();\n                  }}\n                  className={`flex flex-col items-center justify-center p-3 rounded-xl border transition-all ${\n                    selectedShape === s.id\n                      ? \'bg-orange-50 border-orange-500 ring-2 ring-orange-500/20 text-orange-800 font-semibold\'\n                      : \'border-stone-200 hover:border-orange-300 hover:bg-orange-50/50 text-stone-700\'\n                  }`}\n                >\n                  {s.icon}\n                  <span className=\"text-xs mt-1.5 text-center\">{s.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <div>\n            <span className=\"text-[11px] font-bold uppercase tracking-wider text-stone-600 block mb-2\">\n              Geometric Shapes\n            </span>\n            <div className=\"grid grid-cols-3 gap-2\">\n              {shapes.filter(s => s.category === \'classic\').map((s) => (\n                <button\n                  key={s.id}\n                  onClick={() => {\n                    onSelectShape(s.id);\n                    onClose();\n                  }}\n                  className={`flex flex-col items-center justify-center p-3 rounded-xl border transition-all ${\n                    selectedShape === s.id\n                      ? \'bg-orange-50 border-orange-500 ring-2 ring-orange-500/20 text-orange-800 font-semibold\'\n                      : \'border-stone-200 hover:border-stone-300 hover:bg-stone-50 text-stone-700\'\n                  }`}\n                >\n                  {s.icon}\n                  <span className=\"text-xs mt-1.5 text-center\">{s.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-5 pt-3 border-t border-stone-200 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 text-xs font-semibold text-stone-600 hover:text-stone-900 bg-stone-100 hover:bg-stone-200 rounded-lg\"\n          >\n            Cancel\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    overwrite: true
  }
}
